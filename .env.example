# CockroachDB connection string (get from CockroachDB Cloud console -> Connect)
# Example: postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
DATABASE_URL=

# AWS region where Bedrock models are enabled (e.g. us-east-1, us-west-2)
AWS_REGION=

# Bedrock model ID used to generate embeddings (e.g. amazon.titan-embed-text-v2:0)
BEDROCK_EMBEDDING_MODEL_ID=

# Bedrock model ID used as the conflict-resolution arbiter (e.g. anthropic.claude-3-5-sonnet-20241022-v2:0)
BEDROCK_ARBITER_MODEL_ID=
